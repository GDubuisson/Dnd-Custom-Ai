<div class="item-sheet-body wizard-body">
  <p class="field-note wizard-intro">{{localize "DND_CUSTOM.Wizard.Intro"}}</p>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Wizard.CharacterName"}}</label>
    <input type="text" name="name" value="{{name}}">
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Actor.Origin"}}</label>
    <select name="origin">
      <option value="">—</option>
      {{#each originOptions}}
      <option value="{{this.key}}">{{this.label}}</option>
      {{/each}}
    </select>
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Actor.Class"}}</label>
    <select name="classKey">
      <option value="">—</option>
      {{#each classOptions}}
      <option value="{{this.key}}">{{localize this.label}}</option>
      {{/each}}
    </select>
  </div>

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Wizard.AbilitiesTitle"}}</legend>
    <p class="field-note">{{localize "DND_CUSTOM.Wizard.AbilitiesHelp"}}</p>
    {{#each abilities}}
    <div class="form-row">
      <label>{{localize this.label}}</label>
      <select name="abilities.{{this.key}}">
        {{#each this.options}}
        <option value="{{this.value}}" {{#if this.selected}}selected{{/if}}>{{this.value}}</option>
        {{/each}}
      </select>
    </div>
    {{/each}}
  </fieldset>

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Wizard.SkillsTitle"}}</legend>
    <p class="field-note">{{localize "DND_CUSTOM.Wizard.SkillsHelp"}}</p>
    <div class="wizard-skills-grid">
      {{#each skills}}
      <label class="checkbox-row"><input type="checkbox" name="skills.{{this.key}}"> {{localize this.label}}</label>
      {{/each}}
    </div>
  </fieldset>

  <button type="submit">{{localize "DND_CUSTOM.Wizard.Submit"}}</button>
</div>
