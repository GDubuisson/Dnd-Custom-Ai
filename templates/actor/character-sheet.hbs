<header class="dnd-custom-ai sheet-header">
  <img class="portrait" src="{{actor.img}}" alt="{{actor.name}}">

  <div class="header-fields">
    <input type="text" class="actor-name" name="name" value="{{actor.name}}"
           placeholder="{{localize 'DND_CUSTOM.Actor.Name'}}">

    <div class="header-row">
      <label>{{localize "DND_CUSTOM.Actor.Level"}}
        <input type="number" name="system.attributes.level" value="{{system.attributes.level}}" min="1" {{#unless isGM}}disabled{{/unless}}>
      </label>
      {{#if levelUpAvailable}}
      <span class="level-up-badge" title="{{localize 'DND_CUSTOM.Chat.LevelUpTooltip'}}">
        <i class="fa-solid fa-arrow-up"></i> {{localize "DND_CUSTOM.Actor.LevelUpAvailable"}}
        {{#if isGM}}
        <button type="button" data-action="levelUp">{{localize "DND_CUSTOM.Actions.LevelUp"}}</button>
        {{/if}}
      </span>
      {{/if}}
      <div class="fixed-field">
        <span class="fixed-field-label">{{localize "DND_CUSTOM.Actor.Class"}}</span>
        {{#if classLabel}}
        <button type="button" class="fixed-field-value roll-btn" data-action="openClassSheet" title="{{localize 'DND_CUSTOM.Actor.OpenDescriptionTooltip'}}">{{classLabel}}</button>
        {{else}}
        <span class="fixed-field-value empty">{{localize "DND_CUSTOM.Actor.NoClass"}}</span>
        {{/if}}
      </div>
      <div class="fixed-field">
        <span class="fixed-field-label">{{localize "DND_CUSTOM.Actor.Origin"}}</span>
        {{#if originLabel}}
        <button type="button" class="fixed-field-value roll-btn" data-action="openOriginSheet" title="{{localize 'DND_CUSTOM.Actor.OpenDescriptionTooltip'}}">{{originLabel}}</button>
        {{else}}
        <span class="fixed-field-value empty">{{localize "DND_CUSTOM.Actor.NoOrigin"}}</span>
        {{/if}}
      </div>
    </div>

    <div class="header-row">
      <label class="hp-field">{{localize "DND_CUSTOM.Actor.HP"}}
        <span class="hp-values">
          <input type="number" name="system.attributes.hp.value" value="{{system.attributes.hp.value}}" min="0">
          / <span class="hp-max-value">{{system.attributes.hp.max}}</span>
          <span class="hp-temp" title="{{localize 'DND_CUSTOM.Actor.HPTemp'}}">(+<input type="number" name="system.attributes.hp.temp" value="{{system.attributes.hp.temp}}" min="0">)</span>
        </span>
        <span class="hp-bar-track"><span class="hp-bar-fill" style="width: {{hpPercent}}%"></span></span>
      </label>
      <label>{{localize "DND_CUSTOM.Actor.AC"}}
        <span class="computed-value">{{system.attributes.ac.value}}</span>
      </label>
      <label>{{localize "DND_CUSTOM.Actor.Speed"}}
        <span class="computed-value">{{system.attributes.speed}}</span>
      </label>
    </div>

    {{#if dying.active}}
    <div class="death-panel">
      <span class="death-pips">
        {{localize "DND_CUSTOM.Actor.DeathSuccesses"}}
        {{#each dying.successPips}}<i class="fa-solid fa-circle {{#if this}}filled{{/if}}"></i>{{/each}}
      </span>
      <span class="death-pips failures">
        {{localize "DND_CUSTOM.Actor.DeathFailures"}}
        {{#each dying.failurePips}}<i class="fa-solid fa-circle {{#if this}}filled{{/if}}"></i>{{/each}}
      </span>
      {{#if dying.resolved}}
      <span class="death-status">
        {{#if dying.stabilized}}{{localize "DND_CUSTOM.Actor.Stabilized"}}{{else}}{{localize "DND_CUSTOM.Actor.Dead"}}{{/if}}
      </span>
      {{else}}
      <button type="button" data-action="rollDeathSave">{{localize "DND_CUSTOM.Roll.DeathSave"}}</button>
      {{/if}}
    </div>
    {{/if}}

    <div class="header-actions">
      {{#if showCreationWizardButton}}
      <button type="button" data-action="openCreationWizard" title="{{localize 'DND_CUSTOM.Wizard.OpenTooltip'}}">
        <i class="fa-solid fa-hat-wizard"></i> {{localize "DND_CUSTOM.Wizard.OpenButton"}}
      </button>
      {{/if}}
      <button type="button" data-action="rollInitiative" title="{{localize 'DND_CUSTOM.Roll.InitiativeTooltip'}}">
        <i class="fa-solid fa-bolt"></i> {{localize "DND_CUSTOM.Actions.RollInitiative"}}
      </button>
      <button type="button" data-action="restShort">
        <i class="fa-solid fa-mug-hot"></i> {{localize "DND_CUSTOM.Actions.RestShort"}}
      </button>
      <button type="button" data-action="restLong">
        <i class="fa-solid fa-bed"></i> {{localize "DND_CUSTOM.Actions.RestLong"}}
      </button>
    </div>
  </div>
</header>