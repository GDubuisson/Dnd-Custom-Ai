{{#if classFlavorTitle}}
<div class="class-flavor-header" data-class="{{classFlavorKey}}">
  <span class="class-flavor-seal">
    <i class="fa-solid {{classFlavorIcon}}" aria-hidden="true"></i>
  </span>
  <div class="class-flavor-text">
    <span class="class-flavor-title">{{classFlavorTitle}}</span>
    <span class="class-flavor-tagline">{{classFlavorTagline}}</span>
  </div>
</div>
{{/if}}
