<section class="tab equipment {{tab.cssClass}}" data-group="primary" data-tab="equipment">
  <h2 class="tab-title"><i class="fa-solid fa-shield-halved"></i> {{localize "DND_CUSTOM.Tabs.equipment"}}</h2>

  <div class="equipment-grid">
    <div class="equipment-slot">
      <h3>{{localize "DND_CUSTOM.Equipment.MainHand"}}</h3>
      {{#if equipment.mainHand}}
        <div class="item-line" data-item-id="{{equipment.mainHand.id}}">{{equipment.mainHand.name}}</div>
        {{#with (lookup ../weaponStats equipment.mainHand.id)}}
        <p class="item-stats-line">{{localize "DND_CUSTOM.Inventory.Attack"}} {{this.attackLabel}} · {{this.damageLabel}}{{#if this.versatileLabel}} / {{this.versatileLabel}}{{/if}}{{#unless this.proficient}} <span class="not-proficient-tag">{{localize "DND_CUSTOM.Inventory.NotProficient"}}</span>{{/unless}}</p>
        {{/with}}
      {{else}}
        <p class="empty-slot">{{localize "DND_CUSTOM.Equipment.Empty"}}</p>
      {{/if}}
    </div>

    <div class="equipment-slot">
      <h3>{{localize "DND_CUSTOM.Equipment.OffHand"}}</h3>
      {{#if equipment.offHandOccupiedByMainHand}}
        <p class="empty-slot">{{localize "DND_CUSTOM.Equipment.OccupiedTwoHanded"}}</p>
      {{else if equipment.offHand}}
        <div class="item-line" data-item-id="{{equipment.offHand.id}}">{{equipment.offHand.name}}</div>
        {{#with (lookup ../weaponStats equipment.offHand.id)}}
        <p class="item-stats-line">{{localize "DND_CUSTOM.Inventory.Attack"}} {{this.attackLabel}} · {{this.damageLabel}}{{#if this.versatileLabel}} / {{this.versatileLabel}}{{/if}}{{#unless this.proficient}} <span class="not-proficient-tag">{{localize "DND_CUSTOM.Inventory.NotProficient"}}</span>{{/unless}}</p>
        {{/with}}
        {{#with (lookup ../armorStats equipment.offHand.id)}}
        <p class="item-stats-line">{{localize "DND_CUSTOM.Equipment.ACBonus"}} {{this.acLabel}}</p>
        {{/with}}
      {{else}}
        <p class="empty-slot">{{localize "DND_CUSTOM.Equipment.Empty"}}</p>
      {{/if}}
    </div>

    <div class="equipment-slot">
      <h3>{{localize "DND_CUSTOM.Equipment.Armor"}}</h3>
      {{#if equipment.armor}}
        <div class="item-line" data-item-id="{{equipment.armor.id}}">{{equipment.armor.name}}</div>
        {{#with (lookup ../armorStats equipment.armor.id)}}
        <p class="item-stats-line">{{localize "DND_CUSTOM.Equipment.ACBonus"}} {{this.acLabel}}</p>
        {{/with}}
      {{else}}
        <p class="empty-slot">{{localize "DND_CUSTOM.Equipment.Empty"}}</p>
      {{/if}}
    </div>

    <div class="equipment-slot">
      <h3>{{localize "DND_CUSTOM.Equipment.Accessories"}}</h3>
      {{#if equipment.accessories.length}}
        <ul>
          {{#each equipment.accessories}}
          <li data-item-id="{{this.id}}">
            {{this.name}}
            {{#with (lookup ../armorStats this.id)}}
            <span class="item-stats-inline">({{localize "DND_CUSTOM.Equipment.ACBonus"}} {{this.acLabel}})</span>
            {{/with}}
          </li>
          {{/each}}
        </ul>
      {{else}}
        <p class="empty-slot">{{localize "DND_CUSTOM.Equipment.Empty"}}</p>
      {{/if}}
    </div>
  </div>
</section>
