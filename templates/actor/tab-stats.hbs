<section class="tab stats {{tab.cssClass}}" data-group="primary" data-tab="stats">
  <h2 class="tab-title"><i class="fa-solid fa-chart-simple"></i> {{localize "DND_CUSTOM.Tabs.stats"}}</h2>

  <div class="conditions-panel">
    <h3 class="section-subtitle" data-tooltip="{{glossaryTip 'etat'}}">{{localize "DND_CUSTOM.Conditions.Title"}}</h3>
    <div class="conditions-row">
      <details class="conditions-dropdown">
        <summary class="conditions-summary">
          {{#if activeConditions.length}}
          {{#each activeConditions}}<span class="conditions-summary-chip">{{this.label}}</span>{{/each}}
          {{else}}
          <span class="conditions-summary-empty">{{localize "DND_CUSTOM.Conditions.None"}}</span>
          {{/if}}
          <i class="fa-solid fa-caret-down conditions-summary-caret"></i>
        </summary>
        <div class="conditions-checklist">
          {{#each conditions}}
          <button type="button" class="condition-checkbox-row {{#if this.active}}active{{/if}}" data-action="toggleConditionSelection" data-key="{{this.id}}">
            <i class="fa-solid {{#if this.active}}fa-square-check{{else}}fa-square{{/if}}"></i>
            <img src="{{this.img}}" alt="">
            <span>{{this.label}}</span>
          </button>
          {{/each}}
        </div>
      </details>

      <div class="exhaustion-chip" data-tooltip="{{glossaryTip 'exhaustion'}}">
        <span>{{localize "DND_CUSTOM.Conditions.Exhaustion"}}</span>
        <div class="ability-stepper">
          <button type="button" class="ability-btn" data-action="exhaustionDecrease" aria-label="-">−</button>
          <span class="ability-value">{{system.attributes.exhaustion}}</span>
          <button type="button" class="ability-btn" data-action="exhaustionIncrease" aria-label="+">+</button>
        </div>
      </div>

      {{! Bonus de maîtrise/Initiative/Perception passive : sur la même ligne que Liste d'état/
          Épuisement plutôt que sous la liste de Compétences, cf. retour de test. }}
      <div class="proficiency-bonus" data-tooltip="{{glossaryTip 'bonus-maitrise'}}">
        {{localize "DND_CUSTOM.Actor.ProficiencyBonus"}} : {{proficiencyBonus}}
      </div>
      <div class="derived-stats">
        <span data-tooltip="{{glossaryTip 'initiative'}}">{{localize "DND_CUSTOM.Actor.Initiative"}} : {{initiative.modLabel}}</span>
        <span data-tooltip="{{glossaryTip 'perception-passive'}}">{{localize "DND_CUSTOM.Actor.PassivePerception"}} : {{passivePerception}}</span>
      </div>
      {{! Combat monté (don SRD 5e) : cible le token de la monture puis "Monter" — même
          convention que les Capacités à cible (game.user.targets) qu'ailleurs sur cette fiche. }}
      <div class="mount-chip" title="{{localize 'DND_CUSTOM.Actor.MountTooltip'}}">
        {{#if mount}}
        <span>{{localize "DND_CUSTOM.Actor.MountedOn"}} : {{mount.name}}</span>
        <button type="button" class="ability-btn-text" data-action="dismount">{{localize "DND_CUSTOM.Actor.Dismount"}}</button>
        {{else}}
        <button type="button" class="ability-btn-text" data-action="mount">{{localize "DND_CUSTOM.Actor.Mount"}}</button>
        {{/if}}
      </div>
      {{! Forme sauvage (don SRD 5e) : la prise de forme se fait depuis la Capacité elle-même
          (onglet Capacités, bouton dédié "Prendre forme") — ce chip n'affiche le statut/le
          retour manuel que si une forme est déjà active. }}
      {{#if wildShapeForm}}
      <div class="mount-chip" title="{{localize 'DND_CUSTOM.Actor.WildShapeTooltip'}}">
        <span>{{localize "DND_CUSTOM.Actor.WildShapeForm"}} : {{wildShapeForm.name}}
          ({{wildShapeForm.system.attributes.hp.value}}/{{wildShapeForm.system.attributes.hp.max}} {{localize "DND_CUSTOM.Actor.HP"}},
          {{localize "DND_CUSTOM.Actor.AC"}} {{wildShapeForm.system.attributes.ac.value}},
          {{localize "DND_CUSTOM.Actor.Speed"}} {{wildShapeForm.system.attributes.speed}})</span>
        <button type="button" class="ability-btn-text" data-action="revertWildShape">{{localize "DND_CUSTOM.Actor.RevertWildShape"}}</button>
      </div>
      {{#each wildShapeAttacks}}
      <p class="item-stats-line equipment-roll-row">
        <button type="button" class="equipment-roll-btn equipment-roll-btn-attack" data-action="rollWildShapeAttack" data-index="{{this.index}}" title="{{localize 'DND_CUSTOM.Roll.Tooltip'}}">
          <i class="fa-solid fa-dice-d20"></i> {{this.name}} {{this.attackBonusLabel}}
        </button>
        {{#if this.damageLabel}}
        <button type="button" class="equipment-roll-btn equipment-roll-btn-damage" data-action="rollWildShapeAttackDamage" data-index="{{this.index}}" title="{{localize 'DND_CUSTOM.Roll.DamageTooltip'}}">
          <i class="fa-solid fa-droplet"></i> {{localize "DND_CUSTOM.Inventory.Damage"}} {{this.damageLabel}}
        </button>
        {{/if}}
      </p>
      {{/each}}
      {{/if}}
    </div>
  </div>

  {{! Chantier "types de dégâts" (Phase 1, 2026-08-24) : réglage réservé au MJ, comme la fiche
      Origine (verrouillage MJ/Joueur) — coexiste avec les résistances déjà câblées en dur par
      Capacité (Rage, Résilience draconique...). Retour de test : le tableau complet (une case
      par type de dégât, la plupart jamais cochées) n'a aucune valeur côté Joueur — remplacé par
      un résumé listant uniquement les entrées déjà actives (context.damageAffinitySummary,
      actor-sheet.js), rien du tout si aucune n'est active. }}
  {{#if isGM}}
  <div class="damage-affinity-panel">
    {{#each damageAffinityGroups}}
    <fieldset class="form-group">
      <legend>{{localize this.titleKey}}</legend>
      {{#each this.options}}
      <label class="checkbox-row">
        <input type="checkbox" name="system.combat.{{../field}}" value="{{this.key}}" {{#if this.checked}}checked{{/if}}>
        {{localize this.label}}
      </label>
      {{/each}}
    </fieldset>
    {{/each}}
  </div>
  {{else if damageAffinitySummary.length}}
  <div class="damage-affinity-summary" data-tooltip="{{glossaryTip 'affinite-degats'}}">
    {{#each damageAffinitySummary}}
    <div class="damage-affinity-summary-row">
      <span class="damage-affinity-summary-title">{{localize this.titleKey}}</span>
      <span class="damage-affinity-summary-values">{{this.labelsText}}</span>
    </div>
    {{/each}}
  </div>
  {{/if}}

  <div class="stats-columns">
    <div class="abilities-column">
      {{#each abilities}}
      <div class="ability-card">
        <div class="ability-card-name" data-tooltip="{{glossaryTip 'caracteristique'}}">{{localize this.label}}</div>
        <div class="ability-card-row">
          <div class="ability-main">
            <div class="ability-stepper">
              {{#if ../isGM}}
              <button type="button" class="ability-btn" data-action="abilityDecrease" data-key="{{this.key}}" aria-label="-">−</button>
              {{/if}}
              <span class="ability-value">{{this.total}}</span>
              {{#if ../isGM}}
              <button type="button" class="ability-btn" data-action="abilityIncrease" data-key="{{this.key}}" aria-label="+">+</button>
              {{/if}}
            </div>
            {{#if this.originBonus}}
            <span class="origin-bonus">+{{this.originBonus}} {{localize "DND_CUSTOM.Actor.OriginShort"}}</span>
            {{/if}}
          </div>
          <div class="ability-side">
            <div class="ability-side-item">
              <span class="ability-side-label" data-tooltip="{{glossaryTip 'modificateur'}}">{{localize "DND_CUSTOM.Actor.ModShort"}}</span>
              <button type="button" class="ability-mod roll-btn" data-action="rollAbility" data-key="{{this.key}}" title="{{localize 'DND_CUSTOM.Roll.Tooltip'}}"><i class="fa-solid fa-dice-d20"></i> {{this.modLabel}}</button>
            </div>
            <div class="ability-side-item">
              {{#if ../isGM}}
              <label class="ability-side-label" data-tooltip="{{glossaryTip 'sauvegarde'}}">
                {{localize "DND_CUSTOM.Actor.SaveShort"}}
                <input type="checkbox" name="system.saves.{{this.key}}.proficient" {{#if this.save.proficient}}checked{{/if}}>
              </label>
              {{else}}
              {{! Retour de test : la case à cocher était toujours désactivée pour un Joueur (lecture
                  seule, la maîtrise de sauvegarde découle uniquement de la classe) — affichée comme
                  interactive alors qu'elle ne servait à rien pour lui. Simple indicateur visuel côté
                  Joueur (classe .proficient posée sur le libellé), l'édition reste réservée au MJ. }}
              <span class="ability-side-label {{#if this.save.proficient}}proficient{{/if}}" data-tooltip="{{glossaryTip 'sauvegarde'}}">
                {{localize "DND_CUSTOM.Actor.SaveShort"}}
              </span>
              {{/if}}
              <button type="button" class="save-mod roll-btn" data-action="rollSave" data-key="{{this.key}}" title="{{localize 'DND_CUSTOM.Roll.Tooltip'}}"><i class="fa-solid fa-dice-d20"></i> {{this.save.mod}}</button>
            </div>
          </div>
        </div>
      </div>
      {{/each}}
    </div>

    <div class="skills-column">
      <h3 class="section-subtitle" data-tooltip="{{glossaryTip 'test-competence'}}">{{localize "DND_CUSTOM.Actor.SkillsTitle"}}</h3>
      <ul class="skills-list">
        {{#each skills}}
        <li class="skill {{#if this.proficient}}proficient{{/if}}">
          <label>
            <input type="checkbox" name="system.skills.{{this.key}}.proficient" {{#if this.proficient}}checked{{/if}} {{#unless ../isGM}}disabled{{/unless}}>
            {{this.label}}
          </label>
          <span class="ability-tag">({{this.ability}})</span>
          {{#if this.originAdvantage}}
          <span class="origin-advantage-tag" data-tooltip="{{localize 'DND_CUSTOM.Actor.OriginAdvantageTooltip'}}">{{localize "DND_CUSTOM.Actor.OriginAdvantageShort"}}</span>
          {{/if}}
          {{#if this.armorDisadvantage}}
          <span class="armor-disadvantage-tag" data-tooltip="{{localize 'DND_CUSTOM.Actor.ArmorDisadvantageTooltip'}}">{{localize "DND_CUSTOM.Actor.ArmorDisadvantageShort"}}</span>
          {{/if}}
          {{#if this.jackOfAllTrades}}
          <span class="origin-advantage-tag" data-tooltip="{{localize 'DND_CUSTOM.Actor.JackOfAllTradesTooltip'}}">{{localize "DND_CUSTOM.Actor.JackOfAllTradesShort"}}</span>
          {{/if}}
          <button type="button" class="mod roll-btn" data-action="rollSkill" data-key="{{this.key}}" title="{{localize 'DND_CUSTOM.Roll.Tooltip'}}"><i class="fa-solid fa-dice-d20"></i> {{this.modLabel}}</button>
        </li>
        {{/each}}
      </ul>
    </div>
  </div>
</section>
