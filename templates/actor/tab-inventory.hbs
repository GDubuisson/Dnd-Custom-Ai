<section class="tab inventory {{tab.cssClass}}" data-group="primary" data-tab="inventory">
  <h2 class="tab-title"><i class="fa-solid fa-sack"></i> {{localize "DND_CUSTOM.Tabs.inventory"}}</h2>

  <div class="currency">
    <h3>{{localize "DND_CUSTOM.Inventory.Currency"}}</h3>
    <label>{{localize "DND_CUSTOM.Currency.pc"}} <input type="number" name="system.currency.pc" value="{{system.currency.pc}}" min="0"></label>
    <label>{{localize "DND_CUSTOM.Currency.pa"}} <input type="number" name="system.currency.pa" value="{{system.currency.pa}}" min="0"></label>
    <label>{{localize "DND_CUSTOM.Currency.po"}} <input type="number" name="system.currency.po" value="{{system.currency.po}}" min="0"></label>
    <label>{{localize "DND_CUSTOM.Currency.pp"}} <input type="number" name="system.currency.pp" value="{{system.currency.pp}}" min="0"></label>
    <span class="currency-total">({{currencyTotalCopper}} {{localize "DND_CUSTOM.Currency.pc"}})</span>
  </div>

  <h3 class="section-subtitle">{{localize "DND_CUSTOM.Inventory.WeaponsArmorTitle"}}</h3>
  <table class="inventory-table">
    <thead>
      <tr>
        <th>{{localize "DND_CUSTOM.Inventory.Name"}}</th>
        <th>{{localize "DND_CUSTOM.Inventory.Quantity"}}</th>
        <th>{{localize "DND_CUSTOM.Inventory.Weight"}}</th>
        <th>{{localize "DND_CUSTOM.Inventory.Attack"}}</th>
        <th>{{localize "DND_CUSTOM.Inventory.Damage"}}</th>
        <th>{{localize "DND_CUSTOM.Inventory.Equipped"}}</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each weaponsAndArmor}}
      <tr data-item-id="{{this.id}}">
        <td><a class="item-name-link" data-action="viewItem" title="{{localize 'DND_CUSTOM.Inventory.ViewItem'}}">{{this.name}}</a></td>
        <td><input type="number" class="item-quantity-input" data-item-quantity value="{{this.system.quantity}}" min="0"></td>
        <td>{{formatWeight this.system.weight}}</td>
        {{#with (lookup ../weaponStats this.id)}}
        <td>
          <button type="button" class="roll-btn" data-action="rollWeaponAttack" title="{{localize 'DND_CUSTOM.Roll.Tooltip'}}">{{this.attackLabel}}</button>
          {{#unless this.proficient}}<span class="not-proficient-tag" title="{{localize 'DND_CUSTOM.Inventory.NotProficientTooltip'}}">{{localize "DND_CUSTOM.Inventory.NotProficient"}}</span>{{/unless}}
        </td>
        <td>
          <button type="button" class="roll-btn" data-action="rollWeaponDamage" title="{{localize 'DND_CUSTOM.Roll.DamageTooltip'}}">{{this.damageLabel}}</button>
          {{#if this.versatileLabel}} / <button type="button" class="roll-btn" data-action="rollWeaponDamage" data-versatile="true" title="{{localize 'DND_CUSTOM.Roll.VersatileTooltip'}}">{{this.versatileLabel}}</button>{{/if}}
        </td>
        {{else}}
        <td></td>
        <td>{{#with (lookup ../armorStats this.id)}}{{localize "DND_CUSTOM.Equipment.ACBonus"}} {{this.acLabel}}{{/with}}</td>
        {{/with}}
        <td><input type="checkbox" class="item-equipped-checkbox" data-item-equipped {{#if this.system.equipped}}checked{{/if}}></td>
        <td class="inventory-actions">
          {{#if (isUsableItem this)}}
          <button type="button" class="use-item-btn" data-action="useItem" title="{{localize 'DND_CUSTOM.Inventory.UseItem'}}">
            <i class="fa-solid {{useItemIcon this}}"></i>
          </button>
          {{/if}}
          <button type="button" class="delete-item-btn" data-action="deleteItem" title="{{localize 'DND_CUSTOM.Inventory.DeleteItem'}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </td>
      </tr>
      {{else}}
      <tr><td colspan="7" class="empty-slot">{{localize "DND_CUSTOM.Inventory.Empty"}}</td></tr>
      {{/each}}
    </tbody>
  </table>

  <h3 class="section-subtitle">{{localize "DND_CUSTOM.Inventory.GearToolsTitle"}}</h3>
  <table class="inventory-table">
    <thead>
      <tr>
        <th>{{localize "DND_CUSTOM.Inventory.Name"}}</th>
        <th>{{localize "DND_CUSTOM.Inventory.Quantity"}}</th>
        <th>{{localize "DND_CUSTOM.Inventory.Weight"}}</th>
        <th>{{localize "DND_CUSTOM.Inventory.Equipped"}}</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      {{#each gearAndTools}}
      <tr data-item-id="{{this.id}}">
        <td><a class="item-name-link" data-action="viewItem" title="{{localize 'DND_CUSTOM.Inventory.ViewItem'}}">{{this.name}}</a></td>
        <td><input type="number" class="item-quantity-input" data-item-quantity value="{{this.system.quantity}}" min="0"></td>
        <td>{{formatWeight this.system.weight}}</td>
        <td><input type="checkbox" class="item-equipped-checkbox" data-item-equipped {{#if this.system.equipped}}checked{{/if}}></td>
        <td class="inventory-actions">
          {{#if (isUsableItem this)}}
          <button type="button" class="use-item-btn" data-action="useItem" title="{{localize 'DND_CUSTOM.Inventory.UseItem'}}">
            <i class="fa-solid {{useItemIcon this}}"></i>
          </button>
          {{/if}}
          <button type="button" class="delete-item-btn" data-action="deleteItem" title="{{localize 'DND_CUSTOM.Inventory.DeleteItem'}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </td>
      </tr>
      {{else}}
      <tr><td colspan="5" class="empty-slot">{{localize "DND_CUSTOM.Inventory.Empty"}}</td></tr>
      {{/each}}
    </tbody>
  </table>

  <div class="carrying-capacity">
    <span class="label">
      <span>{{localize "DND_CUSTOM.Inventory.CarriedWeight"}}</span>
      <span>{{formatWeight carriedWeight}} / {{formatWeight carryingCapacity}}</span>
    </span>
    <span class="capacity-bar-track">
      <span class="capacity-bar-fill {{#if overCapacity}}over-capacity{{/if}}" style="width: {{carryingCapacityPercent}}%"></span>
    </span>
  </div>

  <p class="drop-hint">{{localize "DND_CUSTOM.Inventory.DropHint"}}</p>
</section>
