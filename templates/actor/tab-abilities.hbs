<section class="tab abilities {{tab.cssClass}}" data-group="primary" data-tab="abilities">
  {{! Réorganisé pour regrouper les infos "fiche" (DD/bonus, langues, trait d'Origine) avant
      l'identité de classe et la liste Capacités/Sorts elle-même — cf. images_test/img_7.png. }}
  <div class="abilities-top-row">
    {{#if isSpellcaster}}
    <div class="spellcasting-stats">
      <span>{{localize "DND_CUSTOM.Abilities.SpellSaveDC"}} : {{spellcasting.dc}}</span>
      <span>{{localize "DND_CUSTOM.Abilities.SpellAttackBonus"}} : {{spellcasting.attackBonusLabel}}</span>
    </div>
    {{/if}}

    <div class="journal-block languages-block">
      <h3 class="section-subtitle">{{localize "DND_CUSTOM.Journal.LanguagesTitle"}}</h3>
      <ul class="languages-list">
        {{#each languages}}
        <li class="language-chip language-chip-{{this.system.category}}" data-item-id="{{this.id}}" title="{{htmlSnippet this.system.description}}">
          <a class="item-name-link" data-action="viewItem">{{this.name}}</a>
          <button type="button" class="delete-item-btn" data-action="deleteItem" title="{{localize 'DND_CUSTOM.Inventory.DeleteItem'}}">
            <i class="fa-solid fa-trash"></i>
          </button>
        </li>
        {{else}}
        <li class="empty-slot">{{localize "DND_CUSTOM.Journal.NoLanguages"}}</li>
        {{/each}}
      </ul>
    </div>
  </div>

  {{#if originTrait}}
  <div class="origin-trait-panel">
    <strong>{{originTrait.name}}</strong>
    <span class="source">({{localize "DND_CUSTOM.Actor.Origin"}})</span>
    <p>{{originTrait.description}}</p>
  </div>
  {{/if}}

  <h2 class="tab-title">
    <i class="fa-solid fa-book-sparkles"></i>
    {{#if isSpellcaster}}
      {{localize "DND_CUSTOM.Abilities.SpellsAndFeaturesTitle"}}
    {{else}}
      {{localize "DND_CUSTOM.Abilities.FeaturesTitle"}}
    {{/if}}
  </h2>

  {{#if classTabPartial}}{{> (lookup this "classTabPartial") }}{{/if}}

  {{#if isSpellcaster}}
  {{#if spellSlots.length}}
  <div class="spell-slots-row" title="{{#if isPactMagic}}{{localize 'DND_CUSTOM.Abilities.PactMagicTooltip'}}{{else}}{{localize 'DND_CUSTOM.Abilities.SpellSlotsTooltip'}}{{/if}}">
    {{#each spellSlots}}
    <label class="spell-slot-chip">
      {{localize "DND_CUSTOM.Abilities.SpellSlotLevelShort" level=this.level}}
      <input type="number" name="system.spells.slots.{{this.level}}.value" value="{{this.value}}" min="0" max="{{this.max}}">
      <span>/ {{this.max}}</span>
    </label>
    {{/each}}
    {{#if isPactMagic}}
    <span class="pact-magic-badge">{{localize "DND_CUSTOM.Abilities.PactMagicLabel"}}</span>
    {{/if}}
  </div>
  {{/if}}

  {{#if concentratingOn}}
  <div class="concentration-banner">
    <i class="fa-solid fa-brain"></i>
    {{localize "DND_CUSTOM.Abilities.ConcentratingOn"}} <strong>{{concentratingOn}}</strong>
    <button type="button" data-action="dropConcentration">{{localize "DND_CUSTOM.Abilities.DropConcentration"}}</button>
  </div>
  {{/if}}
  {{/if}}

  <div class="abilities-tab-columns">
    <div class="features-column">
      {{#if isSpellcaster}}<h3 class="section-subtitle">{{localize "DND_CUSTOM.Abilities.FeaturesTitle"}}</h3>{{/if}}
      <ul class="features-list">
        {{#each features}}
        <li data-item-id="{{this.id}}">
          {{! Retour de test : ouvrir la fiche complète de l'Item juste pour lire sa description
              était trop lourd (fenêtre séparée) — un simple survol suffit désormais, cf. même
              convention déjà utilisée pour les langues ci-dessus (htmlSnippet). }}
          <strong class="item-name-tooltip" title="{{htmlSnippet this.system.description}}">{{this.name}}</strong>
          {{#if this.system.source}}<span class="source">({{this.system.source}})</span>{{/if}}
          {{#if (isReactionItem this)}}
          <span class="reaction-badge" title="{{this.system.reactionTrigger}}">{{localize "DND_CUSTOM.Item.ActivationTypes.reaction"}}</span>
          {{/if}}
          {{#if this.system.uses.max}}
          <span class="feature-uses" title="{{localize 'DND_CUSTOM.Item.Fields.Uses'}}">{{this.system.uses.value}}/{{this.system.uses.max}}</span>
          {{/if}}
          {{#if this.system.recoversSpellSlots}}
          {{! Aucun bouton : récupération automatique proposée au premier repos court de la
              journée (cf. #onRestShort, actor-sheet.js) — la puce "uses" ci-dessus suffit à
              indiquer la charge restante. }}
          {{else if this.system.offersSpellChoice}}
            {{#unless this.system.chosenLevelOneSpell}}
            <button type="button" class="roll-btn feature-roll-btn" data-action="chooseInitiateMagic" title="{{localize 'DND_CUSTOM.Abilities.ChooseOptionTooltip'}}">
              <i class="fa-solid fa-hand-pointer"></i> {{localize "DND_CUSTOM.Abilities.ChooseOptionConfirm"}}
            </button>
            {{/unless}}
            {{! une fois choisi : aucun bouton, le sort de niveau 1 se lance depuis l'onglet
                Sorts comme n'importe quel autre sort octroyé (cf. #onCastSpell) — la puce
                "uses" ci-dessus indique la charge de cast gratuit restante. }}
          {{else if this.system.offersManeuverChoice}}
          <button type="button" class="roll-btn feature-roll-btn" data-action="useManeuver" {{#if (featureDisabled this ../reactionAvailable ../activeStatuses)}}disabled{{/if}} title="{{localize 'DND_CUSTOM.Roll.Tooltip'}}">
            <i class="fa-solid fa-dice-d20"></i> {{displayRollFormula this.system.rollFormula ../system.attributes.level (localize "DND_CUSTOM.Actor.Level")}}
          </button>
          {{else if this.system.requiresRoll}}
          <button type="button" class="roll-btn feature-roll-btn" data-action="rollFeature" {{#if (featureDisabled this ../reactionAvailable ../activeStatuses)}}disabled{{/if}} title="{{localize 'DND_CUSTOM.Roll.Tooltip'}}">
            <i class="fa-solid fa-dice-d20"></i> {{displayRollFormula this.system.rollFormula ../system.attributes.level (localize "DND_CUSTOM.Actor.Level")}}
          </button>
          {{else if this.system.savingThrow}}
          <button type="button" class="roll-btn feature-roll-btn" data-action="rollFeatureSave" {{#if (featureDisabled this ../reactionAvailable ../activeStatuses)}}disabled{{/if}} title="{{localize 'DND_CUSTOM.Roll.Tooltip'}}">
            <i class="fa-solid fa-dice-d20"></i> {{this.name}}
          </button>
          {{else if this.system.uses.max}}
          <button type="button" class="roll-btn feature-roll-btn" data-action="useFeatureCharge" {{#if (featureDisabled this ../reactionAvailable ../activeStatuses)}}disabled{{/if}} title="{{localize 'DND_CUSTOM.Item.Fields.Uses'}}">
            <i class="fa-solid fa-minus"></i>
          </button>
          {{else if this.system.requiresState}}
          <button type="button" class="roll-btn feature-roll-btn conditional-feature-btn" data-action="useConditionalFeature" {{#if (featureDisabled this ../reactionAvailable ../activeStatuses)}}disabled{{/if}} title="{{localize 'DND_CUSTOM.Abilities.RequiresStateTooltip' state=(conditionLabel ../conditions this.system.requiresState)}}">
            <i class="fa-solid fa-bolt"></i> {{this.name}}
          </button>
          {{else if this.system.grantsChoice}}
            {{#unless (lookup ../featureChoiceMade this.id)}}
            <button type="button" class="roll-btn feature-roll-btn" data-action="chooseFeatureOption" title="{{localize 'DND_CUSTOM.Abilities.ChooseOptionTooltip'}}">
              <i class="fa-solid fa-hand-pointer"></i> {{localize "DND_CUSTOM.Abilities.ChooseOptionConfirm"}}
            </button>
            {{/unless}}
          {{else if this.system.summonsCompanion}}
            {{#unless ../companionAlreadySummoned}}
            <button type="button" class="roll-btn feature-roll-btn" data-action="summonCompanion" title="{{localize 'DND_CUSTOM.Abilities.SummonCompanionTooltip'}}">
              <i class="fa-solid fa-paw"></i> {{localize "DND_CUSTOM.Abilities.SummonCompanionConfirm"}}
            </button>
            {{/unless}}
          {{/if}}
          {{#with (lookup ../featureResourceState this.id)}}
          <button type="button" class="roll-btn feature-roll-btn resource-technique-btn" data-action="useResourceTechnique" {{#if (resourceTechniqueDisabled this .. ../../reactionAvailable)}}disabled{{/if}} title="{{this.remaining}}/{{this.max}} {{this.resourceName}}">
            <i class="fa-solid fa-minus"></i> {{this.resourceName}} : {{this.techniqueName}}
          </button>
          {{/with}}
        </li>
        {{else}}
        <li class="empty-slot">{{localize "DND_CUSTOM.Abilities.NoFeatures"}}</li>
        {{/each}}
      </ul>
    </div>

    {{#if hasAnySpells}}
    <div class="spells-column">
      <h3 class="section-subtitle">{{localize "DND_CUSTOM.Abilities.SpellsTitle"}}</h3>
      {{#each spellsByLevel}}
      <div class="spell-level-group">
        <h4 class="spell-level-subtitle">{{this.label}}</h4>
        <ul class="spells-list">
          {{#each this.spells}}
          <li data-item-id="{{this.item.id}}">
            <strong class="item-name-tooltip" title="{{htmlSnippet this.item.system.description}}">{{this.item.name}}</strong>
            {{#if this.item.system.details}}<span class="spell-details">({{this.item.system.details}})</span>{{/if}}
            {{#if this.item.system.concentration}}<span class="spell-tag" title="{{localize 'DND_CUSTOM.Item.Fields.Concentration'}}">C</span>{{/if}}
            {{#if this.item.system.ritual}}<span class="spell-tag" title="{{localize 'DND_CUSTOM.Item.Fields.Ritual'}}">R</span>{{/if}}
            {{#if (isReactionItem this.item)}}
            <span class="reaction-badge" title="{{this.item.system.reactionTrigger}}">{{localize "DND_CUSTOM.Item.ActivationTypes.reaction"}}</span>
            {{/if}}
            <button type="button" class="roll-btn" data-action="castSpell" {{#if (reactionBlocked this.item ../../reactionAvailable)}}disabled{{/if}} {{#if this.item.system.attack}}title="{{localize 'DND_CUSTOM.Roll.Tooltip'}}"{{/if}}><i class="fa-solid fa-dice-d20"></i> {{localize "DND_CUSTOM.Abilities.Cast"}}</button>
            {{#if this.showDamageButton}}
            <button type="button" class="roll-btn" data-action="rollSpellDamage" title="{{localize 'DND_CUSTOM.Roll.DamageTooltip'}}"><i class="fa-solid fa-droplet"></i> {{localize "DND_CUSTOM.Inventory.Damage"}}</button>
            {{/if}}
            <button type="button" class="delete-item-btn" data-action="deleteItem" title="{{localize 'DND_CUSTOM.Inventory.DeleteItem'}}">
              <i class="fa-solid fa-trash"></i>
            </button>
          </li>
          {{/each}}
        </ul>
      </div>
      {{/each}}
      {{#unless spellsByLevel.length}}
      <p class="empty-slot">{{localize "DND_CUSTOM.Abilities.NoSpells"}}</p>
      {{/unless}}
    </div>
    {{/if}}
  </div>
</section>
