<section class="tab stats {{tab.cssClass}}" data-group="primary" data-tab="stats">
  <h2 class="tab-title"><i class="fa-solid fa-chart-simple"></i> {{localize "DND_CUSTOM.Tabs.stats"}}</h2>

  <div class="abilities-grid">
    {{#each abilities}}
    <div class="ability-block">
      <label>{{localize this.label}}</label>
      <input type="number" name="system.abilities.{{this.key}}.mod" value="{{this.mod}}">
      <button type="button" class="mod roll-btn" data-action="rollAbility" data-key="{{this.key}}" title="{{localize 'DND_CUSTOM.Roll.Tooltip'}}"><i class="fa-solid fa-dice-d20"></i> {{localize "DND_CUSTOM.Actor.SaveShort"}} {{this.modLabel}}</button>
    </div>
    {{/each}}
  </div>

  {{#each attacks}}
  <div class="npc-attack-panel">
    <h3 class="section-subtitle">
      {{localize "DND_CUSTOM.Npc.AttackTitle"}}
      <button type="button" class="npc-attack-remove-btn" data-action="removeNpcAttack" data-index="{{this.index}}" title="{{localize 'DND_CUSTOM.Npc.RemoveAttack'}}">
        <i class="fa-solid fa-trash"></i>
      </button>
    </h3>
    <div class="npc-attack-fields">
      <label class="npc-attack-name-field">{{localize "DND_CUSTOM.Npc.AttackName"}}
        <input type="text" name="system.attacks.{{this.index}}.name" value="{{this.name}}" placeholder="{{this.defaultName}}">
      </label>
      <label>{{localize "DND_CUSTOM.Npc.AttackAbility"}}
        <select name="system.attacks.{{this.index}}.ability">
          {{#each this.abilityOptions}}
          <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "DND_CUSTOM.Npc.AttackBonus"}}
        <input type="number" name="system.attacks.{{this.index}}.bonus" value="{{this.bonus}}">
      </label>
      <label>{{localize "DND_CUSTOM.Npc.AttackDamageDice"}}
        <input type="text" name="system.attacks.{{this.index}}.damage.dice" value="{{this.damageDice}}" placeholder="1d6">
      </label>
      <label>{{localize "DND_CUSTOM.Npc.AttackDamageBonus"}}
        <input type="number" name="system.attacks.{{this.index}}.damage.bonus" value="{{this.damageBonus}}">
      </label>
      <label>{{localize "DND_CUSTOM.Npc.AttackDamageType"}}
        <select name="system.attacks.{{this.index}}.damage.type">
          {{#each this.damageTypeOptions}}
          <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{#if this.label}}{{localize this.label}}{{/if}}</option>
          {{/each}}
        </select>
      </label>
    </div>
    <label class="checkbox-row"><input type="checkbox" name="system.attacks.{{this.index}}.magic" {{#if this.magic}}checked{{/if}}> {{localize "DND_CUSTOM.Item.Fields.Magic"}}</label>
    <div class="npc-attack-fields">
      <label>{{localize "DND_CUSTOM.Item.Fields.SecondaryDamage"}}
        <input type="text" name="system.attacks.{{this.index}}.secondaryDamage.dice" value="{{this.secondaryDamageDice}}" placeholder="1d6">
      </label>
      <label>{{localize "DND_CUSTOM.Npc.AttackDamageType"}}
        <select name="system.attacks.{{this.index}}.secondaryDamage.type">
          {{#each this.secondaryDamageTypeOptions}}
          <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{#if this.label}}{{localize this.label}}{{/if}}</option>
          {{/each}}
        </select>
      </label>
    </div>
    <p class="field-note">{{localize "DND_CUSTOM.Item.Fields.SecondaryDamageNote"}}</p>
    <p class="item-stats-line equipment-roll-row">
      <button type="button" class="equipment-roll-btn equipment-roll-btn-attack" data-action="rollAttack" data-index="{{this.index}}" title="{{localize 'DND_CUSTOM.Roll.Tooltip'}}">
        <i class="fa-solid fa-dice-d20"></i> {{localize "DND_CUSTOM.Inventory.Attack"}} {{this.attackBonusLabel}}
      </button>
      {{#if this.damageDice}}
      <button type="button" class="equipment-roll-btn equipment-roll-btn-damage" data-action="rollAttackDamage" data-index="{{this.index}}" title="{{localize 'DND_CUSTOM.Roll.DamageTooltip'}}">
        <i class="fa-solid fa-droplet"></i> {{localize "DND_CUSTOM.Inventory.Damage"}} {{this.damageLabel}}
      </button>
      {{/if}}
    </p>
  </div>
  {{else}}
  <p class="field-note">{{localize "DND_CUSTOM.Npc.NoAttackConfigured"}}</p>
  {{/each}}
  <button type="button" class="npc-attack-add-btn" data-action="addNpcAttack">
    <i class="fa-solid fa-plus"></i> {{localize "DND_CUSTOM.Npc.AddAttack"}}
  </button>

  <div class="damage-affinity-panel">
    {{#each damageAffinityGroups}}
    <fieldset class="form-group">
      <legend>{{localize this.titleKey}}</legend>
      {{#each this.options}}
      <label class="checkbox-row">
        <input type="checkbox" name="system.{{../field}}" value="{{this.key}}" {{#if this.checked}}checked{{/if}}>
        {{localize this.label}}
      </label>
      {{/each}}
    </fieldset>
    {{/each}}
  </div>

  <div class="conditions-panel">
    <h3 class="section-subtitle">{{localize "DND_CUSTOM.Conditions.Title"}}</h3>
    <details class="conditions-dropdown">
      <summary class="conditions-summary">
        {{#if activeConditions.length}}
        {{#each activeConditions}}<span class="conditions-summary-chip">{{this.label}}</span>{{/each}}
        {{else}}
        <span class="conditions-summary-empty">{{localize "DND_CUSTOM.Conditions.None"}}</span>
        {{/if}}
        <i class="fa-solid fa-caret-down conditions-summary-caret"></i>
      </summary>
      <div class="conditions-checklist">
        {{#each conditions}}
        <button type="button" class="condition-checkbox-row {{#if this.active}}active{{/if}}" data-action="toggleCondition" data-key="{{this.id}}">
          <i class="fa-solid {{#if this.active}}fa-square-check{{else}}fa-square{{/if}}"></i>
          <img src="{{this.img}}" alt="">
          <span>{{this.label}}</span>
        </button>
        {{/each}}
      </div>
    </details>
  </div>
</section>