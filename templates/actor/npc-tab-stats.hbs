<section class="tab stats {{tab.cssClass}}" data-group="primary" data-tab="stats">
  <h2 class="tab-title"><i class="fa-solid fa-chart-simple"></i> {{localize "DND_CUSTOM.Tabs.stats"}}</h2>

  <div class="abilities-grid">
    {{#each abilities}}
    <div class="ability-block">
      <label>{{localize this.label}}</label>
      <input type="number" name="system.abilities.{{this.key}}.mod" value="{{this.mod}}">
      <button type="button" class="mod roll-btn" data-action="rollAbility" data-key="{{this.key}}" title="{{localize 'DND_CUSTOM.Roll.Tooltip'}}"><i class="fa-solid fa-dice-d20"></i> {{localize "DND_CUSTOM.Actor.SaveShort"}} {{this.modLabel}}</button>
    </div>
    {{/each}}
  </div>

  <div class="npc-attack-panel">
    <h3 class="section-subtitle">{{localize "DND_CUSTOM.Npc.AttackTitle"}}</h3>
    <div class="npc-attack-fields">
      <label class="npc-attack-name-field">{{localize "DND_CUSTOM.Npc.AttackName"}}
        <input type="text" name="system.attack.name" value="{{attack.name}}" placeholder="{{attack.defaultName}}">
      </label>
      <label>{{localize "DND_CUSTOM.Npc.AttackAbility"}}
        <select name="system.attack.ability">
          {{#each attack.abilityOptions}}
          <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{localize this.label}}</option>
          {{/each}}
        </select>
      </label>
      <label>{{localize "DND_CUSTOM.Npc.AttackBonus"}}
        <input type="number" name="system.attack.bonus" value="{{attack.bonus}}">
      </label>
      <label>{{localize "DND_CUSTOM.Npc.AttackDamageDice"}}
        <input type="text" name="system.attack.damage.dice" value="{{attack.damageDice}}" placeholder="1d6">
      </label>
      <label>{{localize "DND_CUSTOM.Npc.AttackDamageBonus"}}
        <input type="number" name="system.attack.damage.bonus" value="{{attack.damageBonus}}">
      </label>
      <label>{{localize "DND_CUSTOM.Npc.AttackDamageType"}}
        <select name="system.attack.damage.type">
          {{#each attack.damageTypeOptions}}
          <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{#if this.label}}{{localize this.label}}{{/if}}</option>
          {{/each}}
        </select>
      </label>
    </div>
    <p class="item-stats-line equipment-roll-row">
      <button type="button" class="equipment-roll-btn equipment-roll-btn-attack" data-action="rollAttack" title="{{localize 'DND_CUSTOM.Roll.Tooltip'}}">
        <i class="fa-solid fa-dice-d20"></i> {{localize "DND_CUSTOM.Inventory.Attack"}} {{attack.attackBonusLabel}}
      </button>
      {{#if attack.damageDice}}
      <button type="button" class="equipment-roll-btn equipment-roll-btn-damage" data-action="rollAttackDamage" title="{{localize 'DND_CUSTOM.Roll.DamageTooltip'}}">
        <i class="fa-solid fa-droplet"></i> {{localize "DND_CUSTOM.Inventory.Damage"}} {{attack.damageLabel}}
      </button>
      {{/if}}
    </p>
  </div>

  <div class="conditions-panel">
    <h3 class="section-subtitle">{{localize "DND_CUSTOM.Conditions.Title"}}</h3>
    <details class="conditions-dropdown">
      <summary class="conditions-summary">
        {{#if activeConditions.length}}
        {{#each activeConditions}}<span class="conditions-summary-chip">{{this.label}}</span>{{/each}}
        {{else}}
        <span class="conditions-summary-empty">{{localize "DND_CUSTOM.Conditions.None"}}</span>
        {{/if}}
        <i class="fa-solid fa-caret-down conditions-summary-caret"></i>
      </summary>
      <div class="conditions-checklist">
        {{#each conditions}}
        <button type="button" class="condition-checkbox-row {{#if this.active}}active{{/if}}" data-action="toggleCondition" data-key="{{this.id}}">
          <i class="fa-solid {{#if this.active}}fa-square-check{{else}}fa-square{{/if}}"></i>
          <img src="{{this.img}}" alt="">
          <span>{{this.label}}</span>
        </button>
        {{/each}}
      </div>
    </details>
  </div>
</section>