<section class="tab abilities {{tab.cssClass}}" data-group="primary" data-tab="abilities">
  <h2 class="tab-title"><i class="fa-solid fa-book-sparkles"></i> {{localize "DND_CUSTOM.Tabs.abilities"}}</h2>

  <div class="journal-block">
    <h3>{{localize "DND_CUSTOM.Npc.SpecialAbilities"}}</h3>
    <prose-mirror class="content-sized" name="system.specialAbilities" value="{{system.specialAbilities}}"></prose-mirror>
  </div>

  <div class="journal-block">
    <h3>{{localize "DND_CUSTOM.Npc.Particularity"}}</h3>
    <prose-mirror class="content-sized" name="system.particularity" value="{{system.particularity}}"></prose-mirror>
  </div>
</section>