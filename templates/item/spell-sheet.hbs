<div class="item-sheet-root">
<header class="item-sheet-header">
  <img src="{{item.img}}" alt="{{item.name}}">
  <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'TYPES.Item.spell'}}">
</header>

<div class="item-sheet-body">
  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.SpellClasses"}}</label>
    <input type="text" name="system.classes" value="{{system.classes}}" placeholder="Ensorceleur, Magicien">
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.SpellLevel"}}</label>
    <input type="number" name="system.level" value="{{system.level}}" min="0" max="9">
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.SpellSchool"}}</label>
    <select name="system.school">{{selectOptions config.spellSchools selected=system.school localize=true}}</select>
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.CastingTime"}}</label>
    <input type="text" name="system.castingTime" value="{{system.castingTime}}" placeholder="1 action">
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.SpellRange"}}</label>
    <input type="text" name="system.range" value="{{system.range}}" placeholder="18 m">
  </div>

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.Components"}}</legend>
    <label class="checkbox-row"><input type="checkbox" name="system.components.verbal" {{#if system.components.verbal}}checked{{/if}}> {{localize "DND_CUSTOM.Item.Fields.ComponentVerbal"}}</label>
    <label class="checkbox-row"><input type="checkbox" name="system.components.somatic" {{#if system.components.somatic}}checked{{/if}}> {{localize "DND_CUSTOM.Item.Fields.ComponentSomatic"}}</label>
    <label class="checkbox-row"><input type="checkbox" name="system.components.material" {{#if system.components.material}}checked{{/if}}> {{localize "DND_CUSTOM.Item.Fields.ComponentMaterial"}}</label>
    {{#if system.components.material}}
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.MaterialDescription"}}</label>
      <input type="text" name="system.components.materialDescription" value="{{system.components.materialDescription}}">
    </div>
    {{/if}}
  </fieldset>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Duration"}}</label>
    <input type="text" name="system.duration" value="{{system.duration}}" placeholder="Instantanée">
  </div>

  <label class="checkbox-row"><input type="checkbox" name="system.concentration" {{#if system.concentration}}checked{{/if}}> {{localize "DND_CUSTOM.Item.Fields.Concentration"}}</label>
  <label class="checkbox-row"><input type="checkbox" name="system.ritual" {{#if system.ritual}}checked{{/if}}> {{localize "DND_CUSTOM.Item.Fields.Ritual"}}</label>
  {{#if system.level}}
  <label class="checkbox-row"><input type="checkbox" name="system.prepared" {{#if system.prepared}}checked{{/if}}> {{localize "DND_CUSTOM.Item.Fields.Prepared"}}</label>
  {{/if}}

  <div class="form-row description-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Description"}}</label>
    <textarea name="system.description">{{system.description}}</textarea>
  </div>
</div>
</div>
