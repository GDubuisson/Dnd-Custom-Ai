<div class="item-sheet-root">
<header class="item-sheet-header">
  <img src="{{item.img}}" alt="{{item.name}}">
  <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'TYPES.Item.spell'}}">
</header>

<div class="item-sheet-body">
  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.SpellClasses"}}</label>
    <input type="text" name="system.classes" value="{{system.classes}}" placeholder="Ensorceleur, Magicien">
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.SpellLevel"}}</label>
    <input type="number" name="system.level" value="{{system.level}}" min="0" max="9">
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.SpellDetails"}}</label>
    <input type="text" name="system.details" value="{{system.details}}" placeholder="1 action, 18 m, Instantanée">
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Activation"}}</label>
    <select name="system.activation">{{selectOptions config.activationTypes selected=system.activation localize=true}}</select>
  </div>

  {{#if isReaction}}
  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.ReactionTrigger"}}</label>
    <input type="text" name="system.reactionTrigger" value="{{system.reactionTrigger}}">
  </div>
  <p class="field-note">{{localize "DND_CUSTOM.Item.Fields.ReactionTriggerHelp"}}</p>
  {{/if}}

  <label class="checkbox-row"><input type="checkbox" name="system.concentration" {{#if system.concentration}}checked{{/if}}> {{localize "DND_CUSTOM.Item.Fields.Concentration"}}</label>
  <label class="checkbox-row"><input type="checkbox" name="system.ritual" {{#if system.ritual}}checked{{/if}}> {{localize "DND_CUSTOM.Item.Fields.Ritual"}}</label>
  {{#if system.level}}
  <label class="checkbox-row"><input type="checkbox" name="system.prepared" {{#if system.prepared}}checked{{/if}}> {{localize "DND_CUSTOM.Item.Fields.Prepared"}}</label>
  {{/if}}
  <label class="checkbox-row"><input type="checkbox" name="system.attack" {{#if system.attack}}checked{{/if}}> {{localize "DND_CUSTOM.Item.Fields.SpellAttack"}}</label>

  {{#if system.attack}}
  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.Damage"}}</legend>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.DamageDice"}}</label>
      <input type="text" name="system.damage.dice" value="{{system.damage.dice}}" placeholder="1d10">
    </div>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.DamageType"}}</label>
      <select name="system.damage.type">
        <option value=""></option>
        {{selectOptions config.damageTypes selected=system.damage.type localize=true}}
      </select>
    </div>
  </fieldset>
  {{/if}}

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.SpellLight"}}</legend>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.LightBright"}}</label>
      <input type="number" name="system.light.bright" value="{{system.light.bright}}" min="0" step="0.5">
    </div>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.LightDim"}}</label>
      <input type="number" name="system.light.dim" value="{{system.light.dim}}" min="0" step="0.5">
    </div>
  </fieldset>

  <div class="form-row description-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Description"}}</label>
    <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
  </div>
</div>
</div>
