<header class="item-sheet-header">
  <img src="{{item.img}}" alt="{{item.name}}">
  <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'TYPES.Item.vehicle'}}">
</header>

<div class="item-sheet-body">
  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.TransportType"}}</label>
    <select name="system.transportType">{{selectOptions config.transportTypes selected=system.transportType localize=true}}</select>
  </div>

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.Price"}}</legend>
    <div class="price-row">
      <label>{{localize "DND_CUSTOM.Currency.pp"}} <input type="number" name="system.price.pp" value="{{system.price.pp}}" min="0"></label>
      <label>{{localize "DND_CUSTOM.Currency.po"}} <input type="number" name="system.price.po" value="{{system.price.po}}" min="0"></label>
      <label>{{localize "DND_CUSTOM.Currency.pa"}} <input type="number" name="system.price.pa" value="{{system.price.pa}}" min="0"></label>
      <label>{{localize "DND_CUSTOM.Currency.pc"}} <input type="number" name="system.price.pc" value="{{system.price.pc}}" min="0"></label>
    </div>
  </fieldset>

  {{#if showSpeedFields}}
  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Speed"}}</label>
    <input type="number" name="system.speed" value="{{system.speed}}" min="0">
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.CarryCapacity"}}</label>
    <input type="number" name="system.carryCapacity" value="{{system.carryCapacity}}" min="0" step="0.1">
  </div>
  {{/if}}

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Weight"}}</label>
    <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.01">
  </div>

  <div class="form-row description-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Description"}}</label>
    <textarea name="system.description">{{system.description}}</textarea>
  </div>
</div>
