<div class="item-sheet-root">
<header class="item-sheet-header">
  <img src="{{item.img}}" alt="{{item.name}}">
  <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'TYPES.Item.feature'}}">
</header>

<div class="item-sheet-body">
  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Class"}}</label>
    <input type="text" name="system.class" value="{{system.class}}" list="feature-class-options">
    <datalist id="feature-class-options">
      {{#each classOptions}}
      <option value="{{this}}">
      {{/each}}
    </datalist>
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Level"}}</label>
    <input type="number" name="system.level" value="{{system.level}}" min="1">
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Source"}}</label>
    <input type="text" name="system.source" value="{{system.source}}">
  </div>

  <label class="checkbox-row">
    <input type="checkbox" name="system.requiresRoll" {{#if system.requiresRoll}}checked{{/if}}>
    {{localize "DND_CUSTOM.Item.Fields.RequiresRoll"}}
  </label>

  {{#if system.requiresRoll}}
  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.RollFormula"}}</label>
    <input type="text" name="system.rollFormula" value="{{system.rollFormula}}" placeholder="2d6 + @str">
  </div>
  {{/if}}

  <div class="form-row description-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Description"}}</label>
    <textarea name="system.description">{{system.description}}</textarea>
  </div>
</div>
</div>
