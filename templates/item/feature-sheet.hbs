<div class="item-sheet-root">
<header class="item-sheet-header">
  <img src="{{item.img}}" alt="{{item.name}}">
  <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'TYPES.Item.feature'}}" {{#unless isGM}}disabled{{/unless}}>
</header>

<div class="item-sheet-body">
  {{#unless isGM}}
  <p class="field-note">{{localize "DND_CUSTOM.Item.Fields.GmOnlyNotice"}}</p>
  {{/unless}}

  <label class="checkbox-row">
    <input type="checkbox" name="system.universal" {{#if system.universal}}checked{{/if}} {{#unless isGM}}disabled{{/unless}}>
    {{localize "DND_CUSTOM.Item.Fields.Universal"}}
  </label>
  <p class="field-note">{{localize "DND_CUSTOM.Item.Fields.UniversalHelp"}}</p>

  {{#unless system.universal}}
  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Class"}}</label>
    <select name="system.class" {{#unless isGM}}disabled{{/unless}}>
      <option value=""></option>
      {{selectOptions config.classes selected=system.class localize=true}}
    </select>
  </div>
  {{/unless}}

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Subclass"}}</label>
    <select name="system.subclass" {{#unless isGM}}disabled{{/unless}}>
      <option value=""></option>
      {{selectOptions subclassOptions selected=system.subclass localize=true}}
    </select>
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Level"}}</label>
    <input type="number" name="system.level" value="{{system.level}}" min="1" {{#unless isGM}}disabled{{/unless}}>
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Source"}}</label>
    <input type="text" name="system.source" value="{{system.source}}" {{#unless isGM}}disabled{{/unless}}>
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Activation"}}</label>
    <select name="system.activation" {{#unless isGM}}disabled{{/unless}}>{{selectOptions config.activationTypes selected=system.activation localize=true}}</select>
  </div>

  {{#if isReaction}}
  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.ReactionTrigger"}}</label>
    <input type="text" name="system.reactionTrigger" value="{{system.reactionTrigger}}" {{#unless isGM}}disabled{{/unless}}>
  </div>
  <p class="field-note">{{localize "DND_CUSTOM.Item.Fields.ReactionTriggerHelp"}}</p>
  {{/if}}

  <label class="checkbox-row">
    <input type="checkbox" name="system.requiresRoll" {{#if system.requiresRoll}}checked{{/if}} {{#unless isGM}}disabled{{/unless}}>
    {{localize "DND_CUSTOM.Item.Fields.RequiresRoll"}}
  </label>

  {{#if system.requiresRoll}}
  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.RollFormula"}}</label>
    <input type="text" name="system.rollFormula" value="{{system.rollFormula}}" placeholder="2d6 + @str" {{#unless isGM}}disabled{{/unless}}>
  </div>
  {{/if}}

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.CostsResource"}}</label>
    <input type="text" name="system.costsResource" value="{{system.costsResource}}" placeholder="Ki" {{#unless isGM}}disabled{{/unless}}>
  </div>

  {{#if system.offersAbilityChoice}}
  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.ChosenAbility"}}</label>
    <select name="system.chosenAbility" {{#unless isGM}}disabled{{/unless}}>
      <option value=""></option>
      {{selectOptions config.abilities selected=system.chosenAbility localize=true}}
    </select>
  </div>
  <p class="field-note">{{localize "DND_CUSTOM.Item.Fields.ChosenAbilityHelp"}}</p>
  {{/if}}

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.Uses"}}</legend>
    <p class="field-note">{{localize "DND_CUSTOM.Item.Fields.UsesHelp"}}</p>
    {{#if system.scalesWithLevel}}
    <p class="field-note">{{localize "DND_CUSTOM.Item.Fields.UsesScalesWithLevel" max=system.uses.max}}</p>
    {{else}}
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.UsesMax"}}</label>
      <input type="number" name="system.uses.max" value="{{system.uses.max}}" min="0" {{#unless isGM}}disabled{{/unless}}>
    </div>
    {{/if}}
    {{#if system.uses.max}}
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.UsesValue"}}</label>
      <input type="number" name="system.uses.value" value="{{system.uses.value}}" min="0" max="{{system.uses.max}}" {{#unless isGM}}disabled{{/unless}}>
    </div>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.UsesRecharge"}}</label>
      <select name="system.uses.recharge" {{#unless isGM}}disabled{{/unless}}>{{selectOptions rechargeOptions selected=system.uses.recharge localize=true}}</select>
    </div>
    {{/if}}
  </fieldset>

  <div class="form-row description-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Description"}}</label>
    <prose-mirror class="content-sized" name="system.description" value="{{system.description}}" {{#unless isGM}}disabled{{/unless}}></prose-mirror>
  </div>
</div>
</div>
