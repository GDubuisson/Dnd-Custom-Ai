<div class="item-sheet-root">
<header class="item-sheet-header">
  <img src="{{item.img}}" alt="{{item.name}}">
  <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'TYPES.Item.origin'}}">
</header>

<div class="item-sheet-body">
  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Demonym"}}</label>
    <input type="text" name="system.demonym" value="{{system.demonym}}">
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Language"}}</label>
    <input type="text" name="system.language" value="{{system.language}}">
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Inspiration"}}</label>
    <input type="text" name="system.inspiration" value="{{system.inspiration}}">
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Traits"}}</label>
    <input type="text" name="system.traits" value="{{system.traits}}">
  </div>

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.AbilityBonuses"}}</legend>
    {{#each abilityBonusFields}}
    <div class="form-row">
      <label>{{localize this.label}}</label>
      <input type="number" name="system.abilityBonuses.{{this.key}}" value="{{this.value}}">
    </div>
    {{/each}}
  </fieldset>

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.SkillAdvantages"}}</legend>
    {{#each skillAdvantageOptions}}
    <label class="checkbox-row">
      <input type="checkbox" name="system.skillAdvantages" value="{{this.key}}" {{#if this.checked}}checked{{/if}}>
      {{localize this.label}}
    </label>
    {{/each}}
  </fieldset>

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.SpecialTrait"}}</legend>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.SpecialTraitName"}}</label>
      <input type="text" name="system.specialTrait.name" value="{{system.specialTrait.name}}">
    </div>
    <div class="form-row description-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.SpecialTraitDescription"}}</label>
      <textarea name="system.specialTrait.description">{{system.specialTrait.description}}</textarea>
    </div>
  </fieldset>

  <div class="form-row description-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Description"}}</label>
    <textarea name="system.description">{{system.description}}</textarea>
  </div>
</div>
</div>
