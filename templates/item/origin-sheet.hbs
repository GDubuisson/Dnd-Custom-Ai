<div class="item-sheet-root">
<header class="item-sheet-header">
  <img src="{{item.img}}" alt="{{item.name}}">
  <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'TYPES.Item.origin'}}" {{#unless isGM}}disabled{{/unless}}>
</header>

<div class="item-sheet-body">
  {{#unless isGM}}
  <p class="field-note">{{localize "DND_CUSTOM.Item.Fields.CompendiumGmOnlyNotice"}}</p>
  {{/unless}}

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Demonym"}}</label>
    <input type="text" name="system.demonym" value="{{system.demonym}}" {{#unless isGM}}disabled{{/unless}}>
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Language"}}</label>
    <input type="text" name="system.language" value="{{system.language}}" {{#unless isGM}}disabled{{/unless}}>
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Traits"}}</label>
    <input type="text" name="system.traits" value="{{system.traits}}" title="{{system.traits}}" {{#unless isGM}}disabled{{/unless}}>
  </div>

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.AbilityBonuses"}}</legend>
    {{#each abilityBonusFields}}
    <div class="form-row">
      <label>{{localize this.label}}</label>
      <input type="number" name="system.abilityBonuses.{{this.key}}" value="{{this.value}}" {{#unless ../isGM}}disabled{{/unless}}>
    </div>
    {{/each}}
  </fieldset>

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.SkillAdvantages"}}</legend>
    <details class="checklist-dropdown">
      <summary class="checklist-summary">
        {{#if checkedSkillAdvantages.length}}
        {{#each checkedSkillAdvantages}}<span class="checklist-summary-chip">{{localize this.label}}</span>{{/each}}
        {{else}}
        <span class="checklist-summary-empty">{{localize "DND_CUSTOM.Item.Fields.SkillAdvantagesNone"}}</span>
        {{/if}}
        <i class="fa-solid fa-caret-down checklist-summary-caret"></i>
      </summary>
      <div class="checklist-options">
        {{#each skillAdvantageOptions}}
        <label class="checklist-option-row">
          <input type="checkbox" name="system.skillAdvantages" value="{{this.key}}" {{#if this.checked}}checked{{/if}} {{#unless ../isGM}}disabled{{/unless}}>
          {{localize this.label}}
        </label>
        {{/each}}
      </div>
    </details>
  </fieldset>

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.SpecialTrait"}}</legend>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.SpecialTraitName"}}</label>
      <input type="text" name="system.specialTrait.name" value="{{system.specialTrait.name}}" {{#unless isGM}}disabled{{/unless}}>
    </div>
    <div class="form-row description-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.SpecialTraitDescription"}}</label>
      <prose-mirror name="system.specialTrait.description" value="{{system.specialTrait.description}}" {{#unless isGM}}disabled{{/unless}}></prose-mirror>
    </div>
  </fieldset>

  <div class="form-row description-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Description"}}</label>
    <prose-mirror name="system.description" value="{{system.description}}" {{#unless isGM}}disabled{{/unless}}></prose-mirror>
  </div>
</div>
</div>
