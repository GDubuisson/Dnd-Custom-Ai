{{> "systems/dnd-custom-ai/templates/item/parts/header.hbs" placeholder="TYPES.Item.tool" notice="DND_CUSTOM.Item.Fields.EquipmentGmOnlyNotice"}}

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Weight"}}</label>
    <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.01" {{#unless isGM}}disabled{{/unless}}>
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Quantity"}}</label>
    <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" {{#unless isGM}}disabled{{/unless}}>
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Equipped"}}</label>
    <input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}} {{#unless isGM}}disabled{{/unless}}>
  </div>

  {{> "systems/dnd-custom-ai/templates/item/parts/price.hbs"}}

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.UseEffect"}}</legend>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.Skill"}}</label>
      <select name="system.useEffect.skill" {{#unless isGM}}disabled{{/unless}}>
        <option value=""></option>
        {{selectOptions config.skills selected=system.useEffect.skill localize=true}}
      </select>
    </div>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.Bonus"}}</label>
      <input type="number" name="system.useEffect.bonus" value="{{system.useEffect.bonus}}" {{#unless isGM}}disabled{{/unless}}>
    </div>
  </fieldset>

  {{> "systems/dnd-custom-ai/templates/item/parts/description.hbs" field="descriptionRP" label="DND_CUSTOM.Item.Fields.DescriptionRP"}}
</div>
</div>
