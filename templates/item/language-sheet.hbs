<div class="item-sheet-root">
<header class="item-sheet-header">
  <img src="{{item.img}}" alt="{{item.name}}">
  <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'TYPES.Item.language'}}" {{#unless isGM}}disabled{{/unless}}>
</header>

<div class="item-sheet-body">
  {{#unless isGM}}
  <p class="field-note">{{localize "DND_CUSTOM.Item.Fields.CompendiumGmOnlyNotice"}}</p>
  {{/unless}}

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.LanguageCategory"}}</label>
    <select name="system.category" {{#unless isGM}}disabled{{/unless}}>{{selectOptions config.languageCategories selected=system.category localize=true}}</select>
  </div>

  <div class="form-row description-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Description"}}</label>
    <prose-mirror class="content-sized" name="system.description" value="{{system.description}}" {{#unless isGM}}disabled{{/unless}}></prose-mirror>
  </div>
</div>
</div>
