{{!-- Cadre commun des fiches d'Item (image, nom, note MJ), à utiliser en partial à bloc :
    {{#> "…/parts/header.hbs" placeholder=… notice=…}} corps de la fiche {{/"…/parts/header.hbs"}}.
    Paramètres : `placeholder` (clé i18n du type), `notice` (clé i18n de la note MJ). --}}
<div class="item-sheet-root">
<header class="item-sheet-header">
  <img src="{{item.img}}" alt="{{item.name}}">
  <input type="text" name="name" value="{{item.name}}" placeholder="{{localize placeholder}}" {{#unless isGM}}disabled{{/unless}}>
</header>

<div class="item-sheet-body">
  {{#unless isGM}}
  <p class="field-note">{{localize notice}}</p>
  {{/unless}}
{{> @partial-block}}
</div>
</div>
