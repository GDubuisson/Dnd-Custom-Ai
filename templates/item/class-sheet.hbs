{{> "systems/dnd-custom-ai/templates/item/parts/header.hbs" placeholder="TYPES.Item.class" notice="DND_CUSTOM.Item.Fields.CompendiumGmOnlyNotice"}}

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.ClassKey"}}</label>
    <select name="system.classKey" {{#unless isGM}}disabled{{/unless}}>
      <option value=""></option>
      {{selectOptions config.classes selected=system.classKey localize=true}}
    </select>
  </div>
  <p class="field-note">{{localize "DND_CUSTOM.Item.Fields.ClassKeyHelp"}}</p>

  {{#if isSubclass}}
  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.SubclassKey"}}</label>
    <select name="system.subclassKey" {{#unless isGM}}disabled{{/unless}}>
      <option value=""></option>
      {{selectOptions subclassKeyOptions selected=system.subclassKey localize=true}}
    </select>
  </div>
  {{/if}}

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.ClassSavingThrows"}}</legend>
    {{#each savingThrowOptions}}
    <label class="checkbox-row">
      <input type="checkbox" name="system.savingThrows" value="{{this.key}}" {{#if this.checked}}checked{{/if}} {{#unless ../isGM}}disabled{{/unless}}>
      {{localize this.label}}
    </label>
    {{/each}}
  </fieldset>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.ClassSkillChoiceCount"}}</label>
    <input type="number" name="system.skillChoiceCount" value="{{system.skillChoiceCount}}" min="0" {{#unless isGM}}disabled{{/unless}}>
  </div>

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.ClassWeaponProficiencies"}}</legend>
    {{#each weaponProficiencyOptions}}
    <label class="checkbox-row">
      <input type="checkbox" name="system.weaponProficiencies" value="{{this.key}}" {{#if this.checked}}checked{{/if}} {{#unless ../isGM}}disabled{{/unless}}>
      {{localize this.label}}
    </label>
    {{/each}}
  </fieldset>

  {{> "systems/dnd-custom-ai/templates/item/parts/description.hbs" field="description" label="DND_CUSTOM.Item.Fields.Description"}}
</div>
</div>
