<div class="item-sheet-root">
<header class="item-sheet-header">
  <img src="{{item.img}}" alt="{{item.name}}">
  <input type="text" name="name" value="{{item.name}}" placeholder="{{localize 'TYPES.Item.gear'}}">
</header>

<div class="item-sheet-body">
  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Quantity"}}</label>
    <input type="number" name="system.quantity" value="{{system.quantity}}" min="0">
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Weight"}}</label>
    <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.001">
  </div>

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.Price"}}</legend>
    <div class="price-row">
      <label>{{localize "DND_CUSTOM.Currency.pp"}} <input type="number" name="system.price.pp" value="{{system.price.pp}}" min="0"></label>
      <label>{{localize "DND_CUSTOM.Currency.po"}} <input type="number" name="system.price.po" value="{{system.price.po}}" min="0"></label>
      <label>{{localize "DND_CUSTOM.Currency.pa"}} <input type="number" name="system.price.pa" value="{{system.price.pa}}" min="0"></label>
      <label>{{localize "DND_CUSTOM.Currency.pc"}} <input type="number" name="system.price.pc" value="{{system.price.pc}}" min="0"></label>
    </div>
  </fieldset>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Equipped"}}</label>
    <input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}}>
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.CapacityBonus"}}</label>
    <input type="number" name="system.capacityBonus" value="{{system.capacityBonus}}" min="0" step="0.1">
  </div>

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.UseEffect"}}</legend>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.UseType"}}</label>
      <select name="system.use.type">{{selectOptions useTypeOptions selected=system.use.type localize=true}}</select>
    </div>

    {{#if showLightFields}}
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.LightBright"}}</label>
      <input type="number" name="system.use.light.bright" value="{{system.use.light.bright}}" min="0" step="0.5">
    </div>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.LightDim"}}</label>
      <input type="number" name="system.use.light.dim" value="{{system.use.light.dim}}" min="0" step="0.5">
    </div>
    {{/if}}

    {{#if showHealFields}}
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.HealBase"}}</label>
      <input type="number" name="system.use.healBase" value="{{system.use.healBase}}" min="0">
    </div>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.Skill"}}</label>
      <select name="system.use.healSkill">
        <option value=""></option>
        {{selectOptions config.skills selected=system.use.healSkill localize=true}}
      </select>
    </div>
    {{/if}}
  </fieldset>

  <div class="form-row description-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Description"}}</label>
    <prose-mirror name="system.description" value="{{system.description}}"></prose-mirror>
  </div>
</div>
</div>
