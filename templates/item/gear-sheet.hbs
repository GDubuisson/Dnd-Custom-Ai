{{> "systems/dnd-custom-ai/templates/item/parts/header.hbs" placeholder="TYPES.Item.gear" notice="DND_CUSTOM.Item.Fields.EquipmentGmOnlyNotice"}}

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Quantity"}}</label>
    <input type="number" name="system.quantity" value="{{system.quantity}}" min="0" {{#unless isGM}}disabled{{/unless}}>
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Weight"}}</label>
    <input type="number" name="system.weight" value="{{system.weight}}" min="0" step="0.001" {{#unless isGM}}disabled{{/unless}}>
  </div>

  {{> "systems/dnd-custom-ai/templates/item/parts/price.hbs"}}

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.Equipped"}}</label>
    <input type="checkbox" name="system.equipped" {{#if system.equipped}}checked{{/if}} {{#unless isGM}}disabled{{/unless}}>
  </div>

  <div class="form-row">
    <label>{{localize "DND_CUSTOM.Item.Fields.CapacityBonus"}}</label>
    <input type="number" name="system.capacityBonus" value="{{system.capacityBonus}}" min="0" step="0.1" {{#unless isGM}}disabled{{/unless}}>
  </div>

  <fieldset class="form-group">
    <legend>{{localize "DND_CUSTOM.Item.Fields.UseEffect"}}</legend>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.UseType"}}</label>
      <select name="system.use.type" {{#unless isGM}}disabled{{/unless}}>{{selectOptions useTypeOptions selected=system.use.type localize=true}}</select>
    </div>

    {{#if showLightFields}}
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.LightBright"}}</label>
      <input type="number" name="system.use.light.bright" value="{{system.use.light.bright}}" min="0" step="0.5" {{#unless isGM}}disabled{{/unless}}>
    </div>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.LightDim"}}</label>
      <input type="number" name="system.use.light.dim" value="{{system.use.light.dim}}" min="0" step="0.5" {{#unless isGM}}disabled{{/unless}}>
    </div>
    {{/if}}

    {{#if showHealFields}}
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.HealBase"}}</label>
      <input type="number" name="system.use.healBase" value="{{system.use.healBase}}" min="0" {{#unless isGM}}disabled{{/unless}}>
    </div>
    <div class="form-row">
      <label>{{localize "DND_CUSTOM.Item.Fields.Skill"}}</label>
      <select name="system.use.healSkill" {{#unless isGM}}disabled{{/unless}}>
        <option value=""></option>
        {{selectOptions config.skills selected=system.use.healSkill localize=true}}
      </select>
    </div>
    {{/if}}
  </fieldset>

  {{> "systems/dnd-custom-ai/templates/item/parts/description.hbs" field="description" label="DND_CUSTOM.Item.Fields.Description"}}
</div>
</div>
