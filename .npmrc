# cypress-axe@1.7.0 (dernière version publiée) déclare en peer cypress ^10–^15,
# alors que le projet utilise Cypress 16 : sans ce réglage, `npm ci` échoue en
# ERESOLVE. Le package-lock.json a été généré dans ce mode (peer deps non
# installées automatiquement) — à retirer quand cypress-axe acceptera Cypress 16.
legacy-peer-deps=true
