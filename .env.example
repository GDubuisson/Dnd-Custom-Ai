# Copiez ce fichier en `.env` (jamais committé, cf. .gitignore) et renseignez vos identifiants
# Foundry VTT pour lancer l'instance Docker de test (cf. docker-compose.yml,
# ClaudeFiles/testing/SETUP_TESTING.md).

# Clé admin de l'instance de test (libre, sert uniquement à protéger le panneau setup local) —
# doit correspondre à Cypress.env("adminKey") dans cypress.config.js.
FOUNDRY_ADMIN_KEY=test-admin-key

# Identifiants de votre compte Foundry VTT (nécessaires pour que l'image felddy/foundryvtt
# télécharge et installe automatiquement le logiciel Foundry — licence requise, cf. notes du
# guide de setup). Laissez vide si vous préférez une installation manuelle du logiciel dans le
# volume ./data.
FOUNDRY_USERNAME=
FOUNDRY_PASSWORD=
FOUNDRY_LICENSE_KEY=
