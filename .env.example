# Copiez ce fichier en `.env` (jamais committé, cf. .gitignore) et renseignez vos identifiants
# Foundry VTT pour lancer l'instance Docker de test (cf. docker-compose.yml, tests/README.md).

# Clé admin de l'instance de test (libre, sert uniquement à protéger le panneau setup local) —
# doit correspondre à Cypress.expose("adminKey") dans cypress.config.js.
FOUNDRY_ADMIN_KEY=test-admin-key

# Identifiants de votre compte Foundry VTT (nécessaires pour que l'image felddy/foundryvtt
# télécharge et installe automatiquement le logiciel Foundry — licence requise, cf. notes du
# guide de setup). Laissez vide si vous préférez une installation manuelle du logiciel dans le
# volume ./data.
FOUNDRY_USERNAME=
FOUNDRY_PASSWORD=
FOUNDRY_LICENSE_KEY=

# Version exacte de Foundry VTT installée dans le conteneur de test. À épingler explicitement
# plutôt que de laisser l'image `:release` dériver vers le build le plus récent : les builds
# Foundry modifient régulièrement la structure DOM de leurs écrans natifs (/join, /auth...) et
# font alors échouer toute la suite E2E sur un sélecteur, sans qu'aucun code du système ait
# changé — déjà vécu en 14.367 (select -> input) puis en 14.370 (input -> select).
#
# ATTENTION : modifier cette valeur fait RECRÉER le conteneur par `docker compose up -d`, ce qui
# invalide la signature de licence Foundry stockée dans data/Config/license.json — il faut
# ensuite réaccepter le CLUF manuellement dans le navigateur, puis relancer le monde de test.
# Préférer `docker compose stop`/`start` pour tout le reste (cf. tests/README.md).
FOUNDRY_VERSION=14.370
